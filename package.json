{
  "name": "hgame",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "create-game": "node scripts/create-game.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:all": "npm test && npm run test:network",
    "test:network": "npm --prefix network test",
    "test:browser": "node tests/browser-profiles.mjs",
    "test:browser:pbr": "node tests/browser-world-aligned.mjs",
    "process:assets": "node scripts/process-assets.mjs",
    "process:audio": "node scripts/process-audio.mjs",
    "process:model3d": "node scripts/process-model3d.mjs",
    "assets": "node scripts/assets.mjs",
    "bake:vat": "node scripts/bake-bone-vat.mjs",
    "build:physics": "node scripts/build-physics.mjs",
    "check:physics": "node scripts/build-physics.mjs --check",
    "check:network": "npm --prefix network run check",
    "build:network": "npm --prefix network run build",
    "package:game": "node scripts/package-game.mjs",
    "package:toy": "node scripts/package-game.mjs --target toy",
    "toy:check": "node scripts/toy-preflight.mjs",
    "release": "npm run build:physics && npm run check:all && node scripts/package-game.mjs --engine",
    "check:all": "npm run check && npm run test:network && npm run check:network && npm run build:network",
    "check": "npm test && npm run check:physics && npm run check:types && npm run check:api-index",
    "build": "npm run build:physics && npm run build:types && npm run build:api-index",
    "build:types": "node scripts/build-types.mjs",
    "check:types": "node scripts/build-types.mjs --check",
    "bench": "node benchmarks/run.mjs",
    "build:api-index": "node scripts/build-api-index.mjs",
    "check:api-index": "node scripts/build-api-index.mjs --check",
    "snapshot": "node scripts/snapshot.mjs",
    "playtest": "node scripts/playtest.mjs",
    "task:check": "node scripts/task-check.mjs",
    "api": "node scripts/query-api.mjs",
    "re:extract": "node scripts/re-pipeline.mjs extract",
    "re:probe": "node scripts/re-pipeline.mjs probe",
    "re:spec": "node scripts/re-pipeline.mjs spec",
    "re:eval": "node scripts/re-pipeline.mjs eval",
    "re:forge": "node scripts/re-pipeline.mjs forge",
    "re:clean": "node scripts/re-pipeline.mjs clean",
    "re:doctor": "node scripts/doctor-playability.mjs",
    "test:re": "node --test .agents/skills/hgame-reverse-engineering/tests/*.test.mjs .agents/skills/hgame-reverse-engineering/tools/game-reverse-scanner/test/*.test.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "test:examples": "node --test tests/examples.test.mjs examples/survivor-2d/tests/*.test.mjs examples/arena-3d/tests/*.test.mjs examples/signal-vault/tests/*.test.mjs",
    "bench:render": "node benchmarks/render-bench.mjs",
    "bench:render3d": "node benchmarks/render-bench-3d.mjs",
    "test:browser:snapshot": "node tests/browser-snapshot.mjs",
    "test:browser:safety": "node --test --test-concurrency=1 tests/browser-snapshot-safety.mjs tests/browser-visual-regression.mjs",
    "test:browser:telemetry": "node --test tests/browser-playtest-telemetry.mjs",
    "test:browser:packages": "node tests/browser-packages.mjs",
    "check:visual": "node scripts/check-visual-regression.mjs",
    "test:browser:lifecycle": "node tests/browser-game-lifecycle.mjs",
    "test:browser:recipes": "node tests/browser-api-recipes.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier2d-deterministic": "0.21.0",
    "@dimforge/rapier3d-deterministic": "0.21.0",
    "esbuild": "0.25.12",
    "playwright-core": "^1.49.1",
    "rolldown": "1.3.2",
    "typescript": "^5.6.3"
  },
  "types": "types/index.d.ts"
}
