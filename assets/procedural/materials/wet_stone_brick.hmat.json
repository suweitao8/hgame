{
  "format": "hgame.material",
  "version": 1,
  "id": "wet_stone_brick",
  "meta": {
    "category": "masonry",
    "tileMeters": 2.0,
    "seed": 1042
  },
  "params": {
    "mortarWidth": 0.045,
    "wetnessBias": 0.35
  },
  "nodes": [
    {
      "id": "bricks",
      "op": "brick_pattern",
      "args": {
        "rows": 8,
        "cols": 4,
        "stagger": 0.5,
        "mortar": "$mortarWidth",
        "bevel": 0.03,
        "variation": 0.35
      }
    },
    {
      "id": "stone_grain",
      "op": "fbm",
      "args": { "scale": 14, "octaves": 5, "persistence": 0.52, "seamless": true }
    },
    {
      "id": "chipping",
      "op": "worley",
      "args": { "scale": 10, "mode": "f2_minus_f1", "seamless": true }
    },
    {
      "id": "chip_mask",
      "op": "remap",
      "args": { "input": "chipping", "inMin": 0.0, "inMax": 0.22, "outMin": 0.55, "outMax": 1.0 }
    },
    {
      "id": "stone_detail",
      "op": "blend",
      "args": { "mode": "multiply", "a": "stone_grain", "b": "chip_mask", "strength": 0.65 }
    },
    {
      "id": "height_final",
      "op": "blend",
      "args": { "mode": "multiply", "a": "bricks.height", "b": "stone_detail", "strength": 0.32 }
    },
    {
      "id": "normal_map",
      "op": "height_to_normal",
      "args": { "input": "height_final", "strength": 2.6 }
    },
    {
      "id": "brick_tone",
      "op": "blend",
      "args": { "mode": "multiply", "a": "bricks.cellRand", "b": "stone_grain", "strength": 0.35 }
    },
    {
      "id": "albedo_color",
      "op": "color_ramp",
      "args": {
        "input": "brick_tone",
        "stops": [
          [0.0, "#4a4642"],
          [0.5, "#645d55"],
          [1.0, "#7c7267"]
        ]
      }
    },
    {
      "id": "albedo_final",
      "op": "mix_color",
      "args": { "a": "#3d3a36", "b": "albedo_color", "mask": "bricks.mask" }
    },
    {
      "id": "brick_rough",
      "op": "remap",
      "args": { "input": "stone_grain", "inMin": 0.2, "inMax": 0.85, "outMin": 0.32, "outMax": 0.58 }
    },
    {
      "id": "roughness_final",
      "op": "mix_scalar",
      "args": { "a": 0.88, "b": "brick_rough", "mask": "bricks.mask" }
    }
  ],
  "outputs": {
    "albedo": "albedo_final",
    "height": "height_final",
    "normal": "normal_map",
    "ao": { "op": "remap", "input": "height_final", "outMin": 0.45, "outMax": 1.0 },
    "roughness": "roughness_final",
    "metalness": 0.0,
    "porosity": 0.65
  }
}
