{
  "format": "hgame.material",
  "version": 1,
  "id": "aged_plank_wood",
  "meta": {
    "category": "wood",
    "tileMeters": 2.0,
    "seed": 2084
  },
  "params": {
    "plankCount": 6,
    "plankGap": 0.016
  },
  "nodes": [
    {
      "id": "planks",
      "op": "plank_pattern",
      "args": {
        "planks": "$plankCount",
        "joints": 2,
        "gap": "$plankGap",
        "bevel": 0.025,
        "variation": 0.45,
        "nails": true
      }
    },
    {
      "id": "grain",
      "op": "wood_grain",
      "args": { "scale": 5, "ringScale": 18, "distortion": 0.36, "knots": 3, "stretchX": 1, "stretchY": 6 }
    },
    {
      "id": "weathering",
      "op": "fbm",
      "args": { "scale": 10, "octaves": 4, "persistence": 0.55, "seamless": true }
    },
    {
      "id": "height_wood",
      "op": "blend",
      "args": { "mode": "multiply", "a": "planks.height", "b": "grain.height", "strength": 0.35 }
    },
    {
      "id": "normal_map",
      "op": "height_to_normal",
      "args": { "input": "height_wood", "strength": 2.3 }
    },
    {
      "id": "grain_tone",
      "op": "mix_scalar",
      "args": { "a": "planks.cellRand", "b": "grain.grain", "mask": 0.55 }
    },
    {
      "id": "wood_base",
      "op": "color_ramp",
      "args": {
        "input": "grain_tone",
        "stops": [
          [0.0, "#473b2f"],
          [0.5, "#6b543d"],
          [1.0, "#876c4e"]
        ]
      }
    },
    {
      "id": "wood_with_gaps",
      "op": "mix_color",
      "args": { "a": "#403931", "b": "wood_base", "mask": "planks.mask" }
    },
    {
      "id": "albedo_final",
      "op": "mix_color",
      "args": { "a": "wood_with_gaps", "b": "#4a4846", "mask": "planks.nails" }
    },
    {
      "id": "rough_wood",
      "op": "remap",
      "args": { "input": "weathering", "inMin": 0.2, "inMax": 0.85, "outMin": 0.54, "outMax": 0.84 }
    },
    {
      "id": "roughness_final",
      "op": "mix_scalar",
      "args": { "a": 0.92, "b": "rough_wood", "mask": "planks.mask" }
    }
  ],
  "outputs": {
    "albedo": "albedo_final",
    "height": "height_wood",
    "normal": "normal_map",
    "ao": { "op": "remap", "input": "height_wood", "outMin": 0.42, "outMax": 1.0 },
    "roughness": "roughness_final",
    "metalness": 0.0,
    "porosity": 0.52
  }
}
