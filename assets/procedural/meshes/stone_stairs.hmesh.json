{
  "format": "hgame.mesh",
  "version": 1,
  "id": "stone_stairs",
  "meta": {
    "unit": "meter",
    "collider": "auto_boxes"
  },
  "params": {
    "width": 2.2,
    "height": 1.2,
    "depth": 2.4,
    "steps": 6
  },
  "materialSlots": {
    "steps": "concrete_weathered",
    "sideWall": "wet_stone_brick"
  },
  "parts": [
    {
      "id": "treads",
      "op": "stairs",
      "material": "$steps",
      "args": {
        "width": "$width",
        "height": "$height",
        "depth": "$depth",
        "steps": "$steps",
        "bevel": 0.018
      },
      "vertexMeta": { "edgeWear": 0.75, "groundAO": true }
    },
    {
      "id": "stringer_curb",
      "op": "beveled_box",
      "material": "$sideWall",
      "args": {
        "size": [0.18, "expr:$height * 0.45", "$depth"],
        "bevel": 0.02
      },
      "transform": { "pos": ["expr:$width * 0.5 + 0.09", "expr:$height * 0.225", 0] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.65, "groundAO": true }
    }
  ]
}
