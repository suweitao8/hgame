{
  "format": "hgame.mesh",
  "version": 1,
  "id": "heavy_crate",
  "meta": {
    "unit": "meter",
    "collider": "auto_boxes"
  },
  "params": {
    "width": 1.25,
    "height": 1.0,
    "depth": 1.25,
    "ribWidth": 0.075
  },
  "materialSlots": {
    "panel": "aged_plank_wood",
    "frame": "oxidized_rust_metal"
  },
  "parts": [
    {
      "id": "inner_box",
      "op": "beveled_box",
      "material": "$panel",
      "args": { "size": ["$width", "$height", "$depth"], "bevel": 0.02 },
      "transform": { "pos": [0, "expr:$height * 0.5", 0] },
      "vertexMeta": { "edgeWear": 0.55, "groundAO": true }
    },
    {
      "id": "corner_posts",
      "op": "beveled_box",
      "material": "$frame",
      "args": { "size": ["$ribWidth", "expr:$height + 0.012", "$ribWidth"], "bevel": 0.012 },
      "transform": { "pos": ["expr:$width * 0.5 - $ribWidth * 0.45", "expr:$height * 0.5", "expr:$depth * 0.5 - $ribWidth * 0.45"] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.85, "groundAO": true }
    },
    {
      "id": "corner_posts_back",
      "op": "beveled_box",
      "material": "$frame",
      "args": { "size": ["$ribWidth", "expr:$height + 0.012", "$ribWidth"], "bevel": 0.012 },
      "transform": { "pos": ["expr:$width * 0.5 - $ribWidth * 0.45", "expr:$height * 0.5", "expr:-($depth * 0.5 - $ribWidth * 0.45)"] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.85, "groundAO": true }
    },
    {
      "id": "top_bottom_rails_x",
      "op": "beveled_box",
      "material": "$frame",
      "args": { "size": ["expr:$width + 0.016", "$ribWidth", "$ribWidth"], "bevel": 0.012 },
      "repeat": { "count": 2, "stepPos": [0, "expr:$height - $ribWidth", 0] },
      "transform": { "pos": [0, "expr:$ribWidth * 0.5", "expr:$depth * 0.5 - $ribWidth * 0.45"] },
      "mirror": { "axis": "z", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.85 }
    },
    {
      "id": "top_bottom_rails_z",
      "op": "beveled_box",
      "material": "$frame",
      "args": { "size": ["$ribWidth", "$ribWidth", "expr:$depth + 0.016"], "bevel": 0.012 },
      "repeat": { "count": 2, "stepPos": [0, "expr:$height - $ribWidth", 0] },
      "transform": { "pos": ["expr:$width * 0.5 - $ribWidth * 0.45", "expr:$ribWidth * 0.5", 0] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.85 }
    },
    {
      "id": "latches",
      "op": "beveled_box",
      "material": "$frame",
      "args": { "size": [0.08, 0.14, 0.03], "bevel": 0.008 },
      "transform": { "pos": ["expr:$width * 0.25", "expr:$height - 0.16", "expr:$depth * 0.5 + 0.015"] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.9 }
    }
  ]
}
