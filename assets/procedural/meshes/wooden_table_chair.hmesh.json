{
  "format": "hgame.mesh",
  "version": 1,
  "id": "wooden_table_chair",
  "meta": {
    "unit": "meter",
    "collider": "auto_boxes"
  },
  "params": {
    "tableWidth": 1.35,
    "tableDepth": 0.72,
    "tableHeight": 0.75,
    "seatHeight": 0.45
  },
  "materialSlots": {
    "wood": "oak_plank_floor",
    "fabric": "woven_fabric",
    "metal": "oxidized_rust_metal"
  },
  "parts": [
    {
      "id": "table_top",
      "op": "beveled_box",
      "material": "$wood",
      "args": { "size": ["$tableWidth", 0.036, "$tableDepth"], "bevel": 0.012 },
      "transform": { "pos": [0, "expr:$tableHeight - 0.018", 0] },
      "vertexMeta": { "edgeWear": 0.45 }
    },
    {
      "id": "table_apron_z",
      "op": "beveled_box",
      "material": "$wood",
      "args": { "size": ["expr:$tableWidth - 0.12", 0.07, 0.03], "bevel": 0.006 },
      "transform": { "pos": [0, "expr:$tableHeight - 0.07", "expr:$tableDepth * 0.5 - 0.06"] },
      "mirror": { "axis": "z", "keepOriginal": true }
    },
    {
      "id": "table_legs_front",
      "op": "beveled_box",
      "material": "$wood",
      "args": { "size": [0.055, "expr:$tableHeight - 0.036", 0.055], "bevel": 0.008 },
      "transform": { "pos": ["expr:$tableWidth * 0.5 - 0.07", "expr:($tableHeight - 0.036) * 0.5", "expr:$tableDepth * 0.5 - 0.06"] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.4, "groundAO": true }
    },
    {
      "id": "table_legs_back",
      "op": "beveled_box",
      "material": "$wood",
      "args": { "size": [0.055, "expr:$tableHeight - 0.036", 0.055], "bevel": 0.008 },
      "transform": { "pos": ["expr:$tableWidth * 0.5 - 0.07", "expr:($tableHeight - 0.036) * 0.5", "expr:-($tableDepth * 0.5 - 0.06)"] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.4, "groundAO": true }
    },
    {
      "id": "chair_seat_cushion",
      "op": "beveled_box",
      "material": "$fabric",
      "args": { "size": [0.46, 0.055, 0.44], "bevel": 0.018 },
      "transform": { "pos": [0, "$seatHeight", 0.58] },
      "vertexMeta": { "edgeWear": 0.25 }
    },
    {
      "id": "chair_seat_frame",
      "op": "beveled_box",
      "material": "$wood",
      "args": { "size": [0.44, 0.026, 0.42], "bevel": 0.006 },
      "transform": { "pos": [0, "expr:$seatHeight - 0.04", 0.58] }
    },
    {
      "id": "chair_backrest",
      "op": "beveled_box",
      "material": "$fabric",
      "args": { "size": [0.44, 0.28, 0.05], "bevel": 0.016 },
      "transform": { "pos": [0, "expr:$seatHeight + 0.28", 0.79], "rot": [-0.1, 0, 0] },
      "vertexMeta": { "edgeWear": 0.2 }
    },
    {
      "id": "chair_legs_front",
      "op": "cylinder",
      "material": "$metal",
      "args": { "radiusTop": 0.018, "radiusBottom": 0.015, "height": "expr:$seatHeight - 0.04", "segments": 10 },
      "transform": { "pos": [0.19, "expr:($seatHeight - 0.04) * 0.5", 0.4] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "groundAO": true }
    },
    {
      "id": "chair_legs_back",
      "op": "cylinder",
      "material": "$metal",
      "args": { "radiusTop": 0.018, "radiusBottom": 0.015, "height": "expr:$seatHeight + 0.34", "segments": 10 },
      "transform": { "pos": [0.19, "expr:($seatHeight + 0.34) * 0.5", 0.78] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "groundAO": true }
    }
  ]
}
