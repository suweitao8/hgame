{
  "format": "hgame.mesh",
  "version": 1,
  "id": "timber_beam",
  "meta": {
    "unit": "meter",
    "collider": "auto_boxes"
  },
  "params": {
    "length": 4.6,
    "width": 0.16,
    "height": 0.22,
    "bevel": 0.016
  },
  "materialSlots": {
    "primary": "aged_plank_wood",
    "bracket": "rusted_iron"
  },
  "parts": [
    {
      "id": "beam_body",
      "op": "beveled_box",
      "material": "$primary",
      "args": {
        "size": ["$width", "$height", "$length"],
        "bevel": "$bevel"
      },
      "vertexMeta": { "edgeWear": 0.6 }
    },
    {
      "id": "end_straps",
      "op": "beveled_box",
      "material": "$bracket",
      "args": {
        "size": ["expr:$width + 0.025", "expr:$height + 0.025", 0.12],
        "bevel": 0.01
      },
      "transform": { "pos": [0, 0, "expr:$length * 0.5 - 0.18"] },
      "mirror": { "axis": "z", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.85 }
    }
  ]
}
