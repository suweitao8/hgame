{
  "format": "hgame.mesh",
  "version": 1,
  "id": "guard_post",
  "meta": {
    "unit": "meter",
    "collider": "auto_boxes"
  },
  "params": {
    "postWidth": 4.0,
    "wallHeight": 3.0
  },
  "materialSlots": {
    "wallMat": "wet_stone_brick",
    "woodMat": "aged_plank_wood",
    "ironMat": "rusted_iron",
    "baseMat": "concrete_weathered"
  },
  "parts": [
    {
      "id": "foundation_slab",
      "op": "beveled_box",
      "material": "$baseMat",
      "args": {
        "size": [4.9, 0.25, 5.2],
        "bevel": 0.025
      },
      "transform": { "pos": [0, 0.125, 0.2] },
      "vertexMeta": { "edgeWear": 0.75, "groundAO": true, "wetness": 0.25 }
    },
    {
      "id": "back_wall",
      "op": "ref",
      "ref": "beveled_wall",
      "params": { "width": "$postWidth", "height": "$wallHeight", "hasWindow": true },
      "materialOverrides": { "wall": "$wallMat", "trim": "$baseMat" },
      "transform": { "pos": [0, 0.25, -2.0] }
    },
    {
      "id": "left_wall",
      "op": "ref",
      "ref": "beveled_wall",
      "params": { "width": "$postWidth", "height": "$wallHeight", "hasWindow": true },
      "materialOverrides": { "wall": "$wallMat", "trim": "$baseMat" },
      "transform": { "pos": [-2.0, 0.25, 0], "rot": [0, 1.5707963, 0] }
    },
    {
      "id": "right_wall",
      "op": "ref",
      "ref": "beveled_wall",
      "params": { "width": "$postWidth", "height": "$wallHeight", "hasWindow": true },
      "materialOverrides": { "wall": "$wallMat", "trim": "$baseMat" },
      "transform": { "pos": [2.0, 0.25, 0], "rot": [0, 1.5707963, 0] }
    },
    {
      "id": "front_door_wall",
      "op": "beveled_wall_opening",
      "material": "$wallMat",
      "args": {
        "width": 4.0,
        "height": 3.0,
        "thickness": 0.35,
        "bevel": 0.02,
        "openings": [
          { "x": 0, "y": 0, "w": 1.35, "h": 2.25 }
        ]
      },
      "transform": { "pos": [0, 0.25, 2.0] },
      "vertexMeta": { "edgeWear": 0.65, "groundAO": true }
    },
    {
      "id": "corner_pillars_x",
      "op": "beveled_box",
      "material": "$baseMat",
      "args": {
        "size": [0.48, 3.16, 0.48],
        "bevel": 0.022
      },
      "transform": { "pos": [2.0, 1.83, -2.0] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.75, "groundAO": true }
    },
    {
      "id": "corner_pillars_front",
      "op": "beveled_box",
      "material": "$baseMat",
      "args": {
        "size": [0.48, 3.16, 0.48],
        "bevel": 0.022
      },
      "transform": { "pos": [2.0, 1.83, 2.0] },
      "mirror": { "axis": "x", "keepOriginal": true },
      "vertexMeta": { "edgeWear": 0.75, "groundAO": true }
    },
    {
      "id": "roof_beams",
      "op": "ref",
      "ref": "timber_beam",
      "params": { "length": 5.0, "width": 0.16, "height": 0.22 },
      "materialOverrides": { "primary": "$woodMat", "bracket": "$ironMat" },
      "repeat": { "count": 5, "stepPos": [1.0, 0, 0] },
      "transform": { "pos": [-2.0, 3.48, 0] }
    },
    {
      "id": "roof_deck",
      "op": "beveled_box",
      "material": "$woodMat",
      "args": {
        "size": [5.1, 0.12, 5.2],
        "bevel": 0.02
      },
      "transform": { "pos": [0, 3.65, 0] },
      "vertexMeta": { "edgeWear": 0.65 }
    },
    {
      "id": "entry_steps",
      "op": "ref",
      "ref": "stone_stairs",
      "params": { "width": 1.6, "height": 0.25, "depth": 0.85, "steps": 2 },
      "materialOverrides": { "steps": "$baseMat", "sideWall": "$wallMat" },
      "transform": { "pos": [0, 0, 2.95] }
    },
    {
      "id": "front_rail_left",
      "op": "ref",
      "ref": "iron_railing",
      "params": { "length": 1.3, "height": 0.9, "postCount": 3 },
      "materialOverrides": { "iron": "$ironMat" },
      "transform": { "pos": [-1.55, 0.25, 2.65] }
    },
    {
      "id": "front_rail_right",
      "op": "ref",
      "ref": "iron_railing",
      "params": { "length": 1.3, "height": 0.9, "postCount": 3 },
      "materialOverrides": { "iron": "$ironMat" },
      "transform": { "pos": [1.55, 0.25, 2.65] }
    }
  ]
}
