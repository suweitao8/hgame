{
  "name": "new-game",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "api": "node scripts/query-api.mjs",
    "assets": "node scripts/assets.mjs",
    "build": "node scripts/package-game.mjs",
    "release": "node scripts/package-game.mjs",
    "package:toy": "node scripts/package-game.mjs --target toy",
    "toy:check": "node scripts/toy-preflight.mjs .",
    "check:ui": "node scripts/check-ui.mjs --dir .",
    "check:design": "node scripts/check-design-docs.mjs .",
    "snapshot": "node scripts/snapshot.mjs . --check-ui --check-layout",
    "playtest": "node scripts/playtest.mjs . --check-ui --check-layout",
    "doctor": "node scripts/doctor-playability.mjs .",
    "accept": "node scripts/accept.mjs .",
    "accept:webasset": "node scripts/accept.mjs . --webasset",
    "check": "node scripts/accept.mjs . --quick",
    "test": "node --test tests/*.test.mjs"
  }
}
